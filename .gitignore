# Unity generated folders (keep Assets, Packages and ProjectSettings).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE files regenerated by Unity.
/.vs/
/.idea/
/*.csproj
/*.sln
/*.slnx
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj

# Local ActionEncoder environment and generated service state.
/.venv-action-encoder/
/.venv/
/.cache/
/.action-encoder/
__pycache__/
*.py[cod]
.pytest_cache/

# Downloaded installers; installed SDK assets and setup records are retained.
/.setup/downloads/

# Machine-local secrets and OS files.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.pfx
*.p12
*.keystore
.DS_Store
Thumbs.db
Desktop.ini
