{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet semantic action plan v0.1 (proposal)",
  "description": "Structure only. Requires host-bound semantic mapping and compilation into native Action DSL v0.1. A blink-only numerical prototype compiler and receiver are implemented; prediction heads and visual calibration remain pending.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decision", "steps"],
  "properties": {
    "version": {"const": "action-plan.v0.1"},
    "decision": {"enum": ["execute", "none", "unsupported", "ambiguous"]},
    "steps": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actions"],
        "properties": {
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"$ref": "#/$defs/action"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "execute"}}},
      "then": {"properties": {"steps": {"minItems": 1}}},
      "else": {"properties": {"steps": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count", "amplitude"],
      "properties": {
        "type": {"enum": ["nod", "shake_head", "blink"]},
        "count": {"type": "integer", "minimum": 1, "maximum": 5},
        "amplitude": {"enum": ["small", "normal", "large", "full"]},
        "speed": {"enum": ["slow", "normal", "fast"]},
        "period_ms": {"type": "integer", "minimum": 240, "maximum": 3000}
      },
      "oneOf": [{"required": ["speed"]}, {"required": ["period_ms"]}],
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "blink"}}},
          "then": {"properties": {"amplitude": {"const": "full"}}},
          "else": {"properties": {"amplitude": {"enum": ["small", "normal", "large"]}}}
        }
      ]
    }
  }
}
