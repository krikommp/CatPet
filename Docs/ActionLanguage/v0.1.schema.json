{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pet Action Language v0.1 (design draft)",
  "description": "Structural validation only. The host must also validate the active capability profile, parameter ranges and ownership, timing, finite numbers, and request freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "duration_ms", "frames"],
  "properties": {
    "version": { "const": "0.1" },
    "profile": { "type": "string", "minLength": 1, "maxLength": 96 },
    "duration_ms": { "type": "integer", "minimum": 80, "maximum": 10000 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 300 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at_ms", "values"],
        "properties": {
          "at_ms": { "type": "integer", "minimum": 80, "maximum": 10000 },
          "values": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 16,
            "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128 },
            "additionalProperties": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
          }
        }
      }
    }
  }
}
